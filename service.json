{
    "id": "xero",
    "name": "Xero",
    "version": "1.0.3",
    "description": "Connects the shop to Xero (OAuth2) and adds a 'Push to Xero' button on paid orders that creates an AUTHORISED sales invoice. Locked to one named Xero organisation",
    "category": "business",
    "author": {
        "name": "Gavin Cox"
    },
    "license": "proprietary",

    "requires": {
        "osmium": ">=1.0.0",
        "php": ">=8.1",
        "services": []
    },

    "autoload": [
        "models"
    ],

    "migrations": "migrations",

    "hooks": {
        "order.panels": [
            "Osmium\\Services\\Xero\\Models\\XeroOrderSync::orderPanel"
        ],
        "order.action": [
            "Osmium\\Services\\Xero\\Models\\XeroOrderSync::orderAction"
        ]
    },

    "admin": {
        "menu": {
            "section": "Content",
            "items": [
                {
                    "id": "xero",
                    "label": "Xero",
                    "icon": "bx bx-receipt",
                    "route": "admin/settings/xero",
                    "activePattern": "admin/settings/xero",
                    "role": null
                }
            ]
        },
        "routes": {
            "admin/settings/xero": {
                "controller": "controllers/XeroController.php",
                "class": "Osmium\\Services\\Xero\\Controllers\\XeroController",
                "method": "index",
                "title": "Xero"
            },
            "admin/settings/xero/connect": {
                "controller": "controllers/XeroController.php",
                "class": "Osmium\\Services\\Xero\\Controllers\\XeroController",
                "method": "connect",
                "title": "Xero"
            },
            "admin/settings/xero/callback": {
                "controller": "controllers/XeroController.php",
                "class": "Osmium\\Services\\Xero\\Controllers\\XeroController",
                "method": "callback",
                "title": "Xero"
            },
            "admin/settings/xero/action": {
                "controller": "controllers/XeroController.php",
                "class": "Osmium\\Services\\Xero\\Controllers\\XeroController",
                "method": "action",
                "title": "Xero"
            }
        }
    },

    "setup": {
        "requiresConnection": true,
        "postInstallNote": "Pushing is locked until configured. Create a Xero app, enter its client ID/secret on the settings page and add the shown redirect URI to the Xero app. Connect, then set 'Allowed organisation' to the exact name of the connected Xero organisation - pushes are refused unless it matches. Pushing creates real AUTHORISED invoices."
    }
}
