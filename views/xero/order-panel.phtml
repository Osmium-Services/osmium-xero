<div class="card mb-4">
    <div class="card-header"><h5 class="mb-0">Xero</h5></div>
    <div class="card-body">
        <?php if ($xero['synced']) : ?>
            <p class="mb-1"><span class="badge bg-success">Pushed to Xero</span></p>
            <p class="small text-muted mb-0">
                <?= $xero['invoiceNumber'] ? 'Invoice ' . \htmlspecialchars((string) $xero['invoiceNumber']) . ', synced ' : 'Synced ' ?>
                <?= \htmlspecialchars((string) $xero['syncedAt']) ?>
            </p>
        <?php elseif ($xero['canPush']) : ?>
            <button type="button" class="btn btn-outline-primary btn-sm w-100" id="pushToXeroBtn">Push to Xero</button>
            <p class="small text-muted mt-2 mb-0">Creates an AUTHORISED sales invoice in Xero. This cannot be undone from here.</p>
        <?php else : ?>
            <p class="small text-muted mb-0">Only a paid order can be pushed to Xero.</p>
        <?php endif; ?>
    </div>
</div>
<?php if ($xero['canPush']) : ?>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var btn = document.getElementById('pushToXeroBtn');
    if (!btn || !window.osmiumOrder) return;

    btn.addEventListener('click', function () {
        btn.disabled = true;
        window.osmiumOrder.post({ action: 'push_to_xero' }).then(function (data) {
            if (!data.success) {
                window.osmiumOrder.feedback(data.error || 'Could not push to Xero', true);
                btn.disabled = false;
                return;
            }
            window.osmiumOrder.returnToOrder();
        });
    });
});
</script>
<?php endif; ?>
