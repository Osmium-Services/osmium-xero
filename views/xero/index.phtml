<script nonce="<?= $cspNonce ?? '' ?>">
window.csrfToken = <?= \json_encode($template['formToken'] ?? '') ?>;

async function postXeroAction(action) {
    const response = await fetch('<?= $admin['basePath'] ?>settings/xero/action/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action, csrf_token: window.csrfToken }),
    });
    return response.json();
}

async function testConnection() {
    const resultEl = document.getElementById('xeroActionResult');
    resultEl.textContent = 'Testing...';

    const result = await postXeroAction('test_connection');
    resultEl.innerHTML = '';
    const alert = document.createElement('div');
    alert.className = 'alert mb-0 alert-' + (result.success ? 'success' : 'danger');
    alert.textContent = result.success ? 'Connected to "' + (result.organisation || '') + '".' : (result.error || 'Connection test failed');
    resultEl.appendChild(alert);
}

async function disconnectXero() {
    // Not confirm(): native dialogs block browser automation; reconnecting is one click.
    const result = await postXeroAction('disconnect');
    if (result.success) window.location.reload();
    else document.getElementById('xeroActionResult').textContent = result.error || 'Failed to disconnect';
}
</script>
